    {
      "id": "stovetop",
      "label": "爐灶版",
      "note": "全程下鍋燉煮，簡單入味。",
      "steps": [
        {
          "order": 1,
          "instruction": "洋蔥和蒜切末，豆腐切塊備用。",
          "ingredient_ids": [
            "onion--yellow",
            "garlic_raw--minced",
            "tofu--firm"
          ]
        },
        {
          "order": 2,
          "instruction": "熱鍋下適量油，爆香洋蔥末和蒜末。",
          "method_id": "stir_fry_medium_heat",
          "duration_s": 60,
          "ingredient_ids": [
            "vegetable_oil--regular",
            "onion--yellow",
            "garlic_raw--minced"
          ]
        },
        {
          "order": 3,
          "instruction": "放入泡菜炒香，讓酸氣釋放。",
          "method_id": "stir_fry_medium_heat",
          "duration_s": 60,
          "ingredient_ids": [
            "kimchi--fermented"
          ]
        },
        {
          "order": 4,
          "instruction": "加入高湯和水，煮滾。",
          "method_id": "simmer_medium_heat",
          "duration_s": 180,
          "ingredient_ids": [
            "chicken_broth--canned",
            "water--cold"
          ]
        },
        {
          "order": 5,
          "instruction": "加入豬肉片煮熟。",
          "method_id": "simmer_medium_heat",
          "duration_s": 120,
          "ingredient_ids": [
            "pork_belly--sliced"
          ]
        },
        {
          "order": 6,
          "instruction": "放入豆腐燉煮入味（約3-5分鐘），起鍋前用糖、鹽及韓式辣椒粉調味，淋上香油，並打一顆蛋煮到喜歡的熟度即完成。",
          "method_id": "simmer_low_heat",
          "duration_s": 300,
          "ingredient_ids": [
            "tofu--firm",
            "sugar--white",
            "salt--sea",
            "dried_chili--korean_powder",
            "sesame_oil--roasted",
            "egg_chicken--raw"
          ]
        }
      ]
    }
  ],
