  "versions": [
    {
      "method_id": "stovetop",
      "steps": [
        {
          "order": 1,
          "instruction": "備料：洋蔥切塊，馬鈴薯與紅蘿蔔削皮切塊，豬肉切適口大小。",
          "ingredient_ids": [
            "onion--yellow",
            "potato--raw",
            "carrot--raw",
            "pork_belly--raw"
          ]
        },
        {
          "order": 2,
          "instruction": "熱鍋下少許沙拉油，放入洋蔥塊中火炒至半透明且邊緣微焦，釋放香氣。",
          "method_id": "stir_fry_medium_heat",
          "duration_s": 180,
          "ingredient_ids": [
            "vegetable_oil--regular",
            "onion--yellow"
          ]
        },
        {
          "order": 3,
          "instruction": "加入豬肉塊拌炒至表面變色。",
          "method_id": "stir_fry_medium_heat",
          "duration_s": 120,
          "ingredient_ids": [
            "pork_belly--raw"
          ]
        },
        {
          "order": 4,
          "instruction": "放入馬鈴薯與紅蘿蔔稍微翻炒後，倒入開水。大火煮滾後，撈除表面浮沫。",
          "method_id": "simmer_medium_heat",
          "duration_s": 300,
          "ingredient_ids": [
            "potato--raw",
            "carrot--raw",
            "water--cold"
          ]
        },
        {
          "order": 5,
          "instruction": "加蓋轉中小火燉煮約 15-20 分鐘，直到蔬菜變軟。用筷子可輕鬆刺穿馬鈴薯即可。",
          "method_id": "simmer_low_heat",
          "duration_s": 1200,
          "ingredient_ids": []
        },
        {
          "order": 6,
          "instruction": "關火！將咖哩塊分次剝入鍋中，輕輕攪拌至完全融化。",
          "method_id": "mix",
          "duration_s": 120,
          "ingredient_ids": [
            "curry_powder--japanese"
          ]
        },
        {
          "order": 7,
          "instruction": "重新開小火燉煮約 5 分鐘，不斷從鍋底攪拌避免燒焦，直到呈現濃稠狀即完成，搭配白飯享用。",
          "method_id": "simmer_low_heat",
          "duration_s": 300,
          "ingredient_ids": [
            "white_rice--cooked"
          ]
        }
      ]
    }
  ],
  "tips": "加入咖哩塊之前一定要先「關火」，這樣才能順利融化不結塊。想要讓味道更有層次，也可以在起鍋前加入少許番茄醬、蜂蜜或黑巧克力。"
}