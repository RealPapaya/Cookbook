  "versions": [
    {
      "id": "stovetop",
      "label": "爐灶版",
      "note": "慢火燉煮，使雞肉吸滿奶油白酒香氣。",
      "steps": [
        {
          "order": 1,
          "instruction": "雞肉洗淨擦乾，用少許鹽和黑胡椒醃製 15 分鐘。",
          "method_id": "marinate",
          "duration_s": 900,
          "ingredient_ids": [
            "chicken_thigh--boneless",
            "salt--sea",
            "black_pepper--ground"
          ]
        },
        {
          "order": 2,
          "instruction": "鍋中放入奶油，將雞肉表面煎至金黃上色（不用全熟），取出備用。",
          "method_id": "pan_fry_medium_heat",
          "duration_s": 180,
          "ingredient_ids": [
            "butter--unsalted",
            "chicken_thigh--boneless"
          ]
        },
        {
          "order": 3,
          "instruction": "利用鍋中餘油，放入洋蔥丁炒至透明，再加入蒜片爆香。",
          "method_id": "stir_fry_medium_heat",
          "duration_s": 180,
          "ingredient_ids": [
            "onion--yellow",
            "garlic_raw--sliced"
          ]
        },
        {
          "order": 4,
          "instruction": "倒入白酒，煮至酒味稍揮發，接著加入雞高湯與百里香，將雞肉放回鍋中。",
          "method_id": "simmer_medium_heat",
          "duration_s": 120,
          "ingredient_ids": [
            "wine_white--cooking",
            "chicken_broth--canned",
            "thyme--dried"
          ]
        },
        {
          "order": 5,
          "instruction": "蓋上鍋蓋轉中小火燉煮 15 分鐘煮熟雞肉。",
          "method_id": "simmer_low_heat",
          "duration_s": 900,
          "ingredient_ids": []
        },
        {
          "order": 6,
          "instruction": "打開鍋蓋，倒入鮮奶油，轉中火繼續煮至醬汁濃稠，最後依口味加鹽及黑胡椒調整即可。",
          "method_id": "simmer_medium_heat",
          "duration_s": 120,
          "ingredient_ids": [
            "heavy_cream--liquid",
            "salt--sea",
            "black_pepper--ground"
          ]
        }
      ]
    }
  ],
  "tips": "煎雞肉時產生的鍋底焦香是這道菜風味濃郁的來源，務必保留哦！鮮奶油加入後不宜久煮，以免油水分離。",
  "slug": "french-chicken-stew"
}