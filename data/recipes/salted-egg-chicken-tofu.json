  "versions": [
    {
      "id": "stovetop",
      "label": "爐灶版",
      "note": "砂鍋保溫效果好，更能保持煲湯的溫度與風味。",
      "steps": [
        {
          "order": 1,
          "instruction": "雞腿肉切丁，加入米酒、醬油與少許太白粉抓勻，醃漬約 10 分鐘。",
          "method_id": "marinate",
          "duration_s": 600,
          "ingredient_ids": [
            "chicken_thigh--boneless",
            "sake_cooking--rice",
            "soy_sauce--regular",
            "cornstarch--potato"
          ]
        },
        {
          "order": 2,
          "instruction": "雞蛋豆腐切塊，鍋中熱少許油，將豆腐煎至表面微黃，盛起備用。",
          "method_id": "pan_fry_medium_heat",
          "duration_s": 300,
          "ingredient_ids": [
            "tofu--egg",
            "vegetable_oil--regular"
          ]
        },
        {
          "order": 3,
          "instruction": "原鍋用中小火先將鹹蛋黃碎炒至起泡、散發出香氣，再加入蛋白碎繼續拌炒。",
          "method_id": "stir_fry_medium_heat",
          "duration_s": 120,
          "ingredient_ids": [
            "egg_duck--salted"
          ]
        },
        {
          "order": 4,
          "instruction": "加入蒜末炒香，接著放入醃好的雞肉丁炒至變色。",
          "method_id": "stir_fry_high_heat",
          "duration_s": 180,
          "ingredient_ids": [
            "garlic_raw--minced",
            "chicken_thigh--boneless"
          ]
        },
        {
          "order": 5,
          "instruction": "倒入清水煮滾，並放回煎好的豆腐。轉小火蓋上鍋蓋燜煮 5 分鐘。",
          "method_id": "simmer_low_heat",
          "duration_s": 300,
          "ingredient_ids": [
            "water--cold",
            "tofu--egg"
          ]
        },
        {
          "order": 6,
          "instruction": "若需要可加鹽、白胡椒調味。起鍋前以少許太白粉水勾薄芡，撒上蔥花即完成。",
          "method_id": "thicken_sauce",
          "duration_s": 60,
          "ingredient_ids": [
            "salt--sea",
            "white_pepper_powder--ground",
            "cornstarch--potato",
            "green_onion--chopped"
          ]
        }
      ]
    }
  ],
  "tips": "豆腐先煎過可以避免在燉煮時碎裂，並賦予外焦裡嫩的口感。鹹鴨蛋本身的鹹度差異很大，請試味道後再決定要加多少鹽巴喔！",
  "slug": "salted-egg-chicken-tofu"
