  "versions": [
    {
      "id": "stovetop",
      "label": "爐灶版",
      "note": "先爆香沙茶與蒜末再加牛奶，風味更足。",
      "steps": [
        {
          "order": 1,
          "instruction": "熱鍋少許油，放入蒜末與沙茶醬，小火煸香約 30 秒至釋放出香氣。",
          "method_id": "stir_fry_low_heat",
          "duration_s": 30,
          "ingredient_ids": [
            "garlic_raw--minced",
            "shacha_sauce--regular"
          ]
        },
        {
          "order": 2,
          "instruction": "下豬肉片中火拌炒至半熟，接著放入高麗菜略炒。",
          "method_id": "stir_fry_medium_heat",
          "duration_s": 60,
          "ingredient_ids": [
            "pork_slice--raw",
            "cabbage--raw"
          ]
        },
        {
          "order": 3,
          "instruction": "倒入牛奶與適量熱水（稍微淹過食材），大火煮滾後馬上轉小火。",
          "method_id": "simmer_medium_heat",
          "duration_s": 120,
          "ingredient_ids": [
            "milk--raw"
          ]
        },
        {
          "order": 4,
          "instruction": "放入泡發的冬粉，繼續小火煨煮 3 分鐘讓冬粉吸滿濃郁湯汁。",
          "method_id": "simmer_low_heat",
          "duration_s": 180,
          "ingredient_ids": [
            "glass_noodles--soaked"
          ]
        },
        {
          "order": 5,
          "instruction": "起鍋前撒上蔥花即完成。",
          "method_id": "mix",
          "duration_s": 10,
          "ingredient_ids": [
            "green_onion--chopped"
          ]
        }
      ]
    }
  ]
