      "id": "stovetop",
      "label": "爐灶版",
      "note": "最後再放入空心菜快速翻炒，保持青脆口感與鮮綠。",
      "steps": [
        {
          "order": 1,
          "instruction": "豬肉片先用少許醬油抓勻備用。",
          "method_id": "marinate",
          "duration_s": 300,
          "ingredient_ids": [
            "pork_slice--raw",
            "soy_sauce--regular"
          ]
        },
        {
          "order": 2,
          "instruction": "熱鍋熱油，下蒜末與沙茶醬，小火煸炒約 20 秒直到香氣飄出。",
          "method_id": "stir_fry_low_heat",
          "duration_s": 20,
          "ingredient_ids": [
            "garlic_raw--minced",
            "shacha_sauce--regular",
            "vegetable_oil--regular"
          ]
        },
        {
          "order": 3,
          "instruction": "將火力轉為中大火，放入豬肉片迅速翻炒至八分熟。",
          "method_id": "stir_fry_high_heat",
          "duration_s": 60,
          "ingredient_ids": [
            "pork_slice--raw"
          ]
        },
        {
          "order": 4,
          "instruction": "將底下的空心菜梗先下鍋翻炒 15 秒，接著再下菜葉部份，大火翻炒均勻，讓醬汁包覆即可盛盤。",
          "method_id": "stir_fry_high_heat",
          "duration_s": 45,
          "ingredient_ids": [
            "water_spinach--raw"
          ]
        }
      ]
    }
