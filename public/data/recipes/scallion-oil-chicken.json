      "id": "stovetop",
      "label": "爐灶版",
      "note": "利用清蒸雞肉留下的雞汁混合蔥油，風味更佳。",
      "steps": [
        {
          "order": 1,
          "instruction": "雞腿肉洗淨，抹上少許鹽巴與薑泥抓醃 15 分鐘。",
          "method_id": "marinate",
          "duration_s": 900,
          "ingredient_ids": [
            "chicken_thigh--boneless",
            "salt--sea",
            "ginger--paste"
          ]
        },
        {
          "order": 2,
          "instruction": "將雞肉放入蒸盤中，水開後大火蒸 15 分鐘至完全熟透。",
          "method_id": "steam",
          "duration_s": 900,
          "ingredient_ids": [
            "chicken_thigh--boneless"
          ]
        },
        {
          "order": 3,
          "instruction": "取出雞肉稍微放涼後切塊，盤底留下的雞精（雞汁）備用。切好大把蔥花放在雞肉上方。",
          "method_id": "none",
          "ingredient_ids": [
            "green_onion--chopped"
          ]
        },
        {
          "order": 4,
          "instruction": "加熱蔥油直到冒出微煙，混入剛才備用的雞汁，趁熱均勻淋在蔥花與雞肉上噴發香氣。",
          "method_id": "mix",
          "duration_s": 20,
          "ingredient_ids": [
            "scallion_oil--standard"
          ]
        }
