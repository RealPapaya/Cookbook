  "versions": [
    {
      "id": "stovetop",
      "label": "爐灶版",
      "note": "先將鮭魚皮煎至香脆後再加入奶油，能避免奶油焦化過頭。",
      "steps": [
        {
          "order": 1,
          "instruction": "鮭魚表面擦乾水分，均勻撒上鹽與黑胡椒醃 5 分鐘。",
          "method_id": "marinate",
          "duration_s": 300,
          "ingredient_ids": [
            "salmon--fillet",
            "salt--sea",
            "black_pepper--ground"
          ]
        },
        {
          "order": 2,
          "instruction": "鍋中下少許油（非奶油），將鮭魚皮朝下，中火煎至皮脆且肉側變色約 3 分鐘，翻面再煎 2 分鐘。",
          "method_id": "pan_fry_medium_heat",
          "duration_s": 300,
          "ingredient_ids": [
            "salmon--fillet"
          ]
        },
        {
          "order": 3,
          "instruction": "轉小火，放入奶油與蒜末，待奶油融化冒泡後，用湯匙不斷將奶油淋在鮭魚表面約 1 分鐘提香。",
          "method_id": "stir_fry_low_heat",
          "duration_s": 60,
          "ingredient_ids": [
            "butter--unsalted",
            "garlic_raw--minced"
          ]
        },
        {
          "order": 4,
          "instruction": "起鍋裝盤，淋上少許新鮮檸檬汁，最後搭配燙好的青花菜即可。",
          "method_id": "mix",
          "duration_s": 10,
          "ingredient_ids": [
            "lemon--juice",
            "broccoli--raw"
          ]
        }
      ]
    }
  ]
