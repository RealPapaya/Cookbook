    {
      "id": "stovetop",
      "label": "爐灶版",
      "note": "製作時反覆在手中拍打出空氣，能防止煎烤時裂開。",
      "steps": [
        {
          "order": 1,
          "instruction": "洋蔥碎用少許油炒至金黃變軟且散發甜味，取出徹底放涼備用。麵包粉與牛奶於碗中混和預泡。",
          "method_id": "stir_fry_medium_heat",
          "duration_s": 300,
          "ingredient_ids": [
            "onion--yellow",
            "bread_crumb--panko",
            "milk--raw"
          ]
        },
        {
          "order": 2,
          "instruction": "大碗中放入牛、豬絞肉與鹽，快速攪拌至產生黏性。加入冷卻的洋蔥、雞蛋、泡軟的麵包粉與黑胡椒攪拌均勻。",
          "method_id": "mix",
          "duration_s": 180,
          "ingredient_ids": [
            "ground_beef--medium",
            "ground_pork--medium",
            "egg_chicken--raw"
          ]
        },
        {
          "order": 3,
          "instruction": "雙手抹油，將肉餡分成兩份揉圓，反覆左右手拍打出空氣，在中心壓一個小凹糟。",
          "method_id": "none",
          "ingredient_ids": []
        },
        {
          "order": 4,
          "instruction": "熱鍋熱油，下漢堡排中火煎 3 分鐘至上色，翻面後加入 50ml 水或紅酒，蓋上鍋蓋小火蒸煮 5-7 分鐘直到熟透。",
          "method_id": "simmer_low_heat",
          "duration_s": 420,
          "ingredient_ids": []
        }
      ]
    }
  ]
