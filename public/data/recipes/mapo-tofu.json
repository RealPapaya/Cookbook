  "versions": [
    {
      "method_id": "stovetop",
      "steps": [
        {
          "order": 1,
          "instruction": "豆腐切方塊，放入滾水中加少許鹽川燙1分鐘，撈出瀝乾備用（這能讓豆腐不易碎）。"
        },
        {
          "order": 2,
          "instruction": "小碗中將太白粉與水調勻備用（勾芡用）。"
        },
        {
          "order": 3,
          "instruction": "熱鍋冷油，下豬絞肉煸炒至變色並吐出些許油脂。"
        },
        {
          "order": 4,
          "instruction": "加入豆瓣醬炒出紅油，接著下蒜末、薑末炒香。"
        },
        {
          "order": 5,
          "instruction": "倒入清水和醬油，煮滾後放入汆燙好的豆腐，蓋鍋蓋中小火燉煮5分鐘讓豆腐入味。"
        },
        {
          "order": 6,
          "instruction": "分開兩至三次倒入太白粉水勾芡，每次用鍋鏟以推的方式攪拌均勻。"
        },
        {
          "order": 7,
          "instruction": "起鍋前淋入辣椒油，撒上花椒粉與蔥花即可上桌。"
        }
      ]
    }
  ]
}