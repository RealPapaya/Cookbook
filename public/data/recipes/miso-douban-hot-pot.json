  "versions": [
    {
      "id": "stovetop",
      "label": "爐灶版",
      "note": "豆瓣醬先稍微炒香，湯底風味更佳。",
      "steps": [
        {
          "order": 1,
          "instruction": "鍋中下少許油，加入辣豆瓣醬以小火煸炒 1 分鐘，直到紅油釋出。",
          "method_id": "stir_fry_low_heat",
          "duration_s": 60,
          "ingredient_ids": [
            "doubanjiang--spicy"
          ]
        },
        {
          "order": 2,
          "instruction": "倒入約 800ml 開水煮滾。先放入高麗菜、金針菇、豆腐，轉中火將蔬菜煮軟（約 5 分鐘）。",
          "method_id": "simmer_medium_heat",
          "duration_s": 300,
          "ingredient_ids": [
            "cabbage--raw",
            "enoki--raw",
            "tofu--firm"
          ]
        },
        {
          "order": 3,
          "instruction": "用湯勺舀起少許熱湯，在碗中將味噌化開。接著倒入鍋中（注意味噌加入後不要大火久煮以免流失風味）。",
          "method_id": "simmer_low_heat",
          "duration_s": 60,
          "ingredient_ids": [
            "miso--mixed"
          ]
        },
        {
          "order": 4,
          "instruction": "放入豬肉片，燙熟後關火。",
          "method_id": "blanch",
          "duration_s": 60,
          "ingredient_ids": [
            "pork_slice--raw"
          ]
        },
        {
          "order": 5,
          "instruction": "上方撒上切好的蔥段，直接連鍋上桌端享用！",
          "method_id": "mix",
          "duration_s": 0,
          "ingredient_ids": [
            "green_onion--sliced"
          ]
        }
      ]
    }
  ]
