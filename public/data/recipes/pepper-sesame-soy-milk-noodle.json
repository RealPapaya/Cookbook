  "versions": [
    {
      "method_id": "stovetop",
      "steps": [
        {
          "order": 1,
          "instruction": "煮一鍋滾水，將麵條煮至個人喜愛的熟度，撈出瀝乾備用。"
        },
        {
          "order": 2,
          "instruction": "同時熱鍋少許油，將豬絞肉炒熟焦香備用。"
        },
        {
          "order": 3,
          "instruction": "在麵碗中先加入芝麻醬，用少許熱水將芝麻醬化開。"
        },
        {
          "order": 4,
          "instruction": "微波或用小鍋將無糖豆漿加熱至溫熱（不要煮至完全大滾以免油水分離），倒入麵碗中與芝麻醬混合均勻。"
        },
        {
          "order": 5,
          "instruction": "加入醬油、烏醋（鎮江香醋）與四川紅油（花椒油），攪拌為濃郁的椒麻豆漿湯底。"
        },
        {
          "order": 6,
          "instruction": "將煮好的麵條放入湯中，頂部放上炒好的肉末，最後灑上蔥花即可上桌。"
        }
      ]
    }
  ]
}