  "versions": [
    {
      "method_id": "stovetop",
      "steps": [
        {
          "order": 1,
          "instruction": "將雪白菇切除根部撥散，金針菇洗淨切小段。洋蔥切絲。雞蛋打入碗中輕輕打散（保有蛋白蛋黃層次即可，不用打太均勻）。"
        },
        {
          "order": 2,
          "instruction": "平底鍋中加入高湯、醬油、味醂與洋蔥絲，中火煮至洋蔥變軟且湯汁微滾。"
        },
        {
          "order": 3,
          "instruction": "加入雪白菇與切碎的金針菇，煨煮約 2 分鐘至菇類釋放水分且熟透。"
        },
        {
          "order": 4,
          "instruction": "用太白粉加少許水調成太白粉水，倒入鍋中稍微勾芡讓湯汁濃稠（依照自己的喜好決定濃稠度）。"
        },
        {
          "order": 5,
          "instruction": "將打好的蛋液均勻以畫圈方式淋入鍋中，等待約 10-15 秒讓底部蛋液微凝固，再輕輕推動。"
        },
        {
          "order": 6,
          "instruction": "當蛋液呈現半熟滑嫩狀態（約 7 分熟），即可關火。"
        },
        {
          "order": 7,
          "instruction": "將滑蛋雪白菇連同湯汁一起滑在熱騰騰的白飯上，最後撒上蔥花即可享用。"
        }
      ]
    }
  ]
}