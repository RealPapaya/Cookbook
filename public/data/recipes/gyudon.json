  "versions": [
    {
      "method_id": "stovetop",
      "steps": [
        {
          "order": 1,
          "instruction": "洋蔥切絲；將水、柴魚粉、醬油、味醂、清酒、砂糖在小碗中調勻成醬汁備用。",
          "ingredient_ids": [
            "onion--yellow",
            "water--cold",
            "dashi_powder--bonito",
            "soy_sauce--regular",
            "mirin--regular",
            "sake_cooking--rice",
            "sugar--white"
          ]
        },
        {
          "order": 2,
          "instruction": "將調好的醬汁與洋蔥絲放入鍋中，以中小火煮滾。加蓋繼續煮 3-5 分鐘，直到洋蔥變軟並呈現半透明狀。",
          "method_id": "simmer_medium_heat",
          "duration_s": 300,
          "ingredient_ids": []
        },
        {
          "order": 3,
          "instruction": "打開鍋蓋，將牛肉片均勻散開放入鍋中，攪拌避免結塊。",
          "method_id": "simmer_medium_heat",
          "duration_s": 60,
          "ingredient_ids": [
            "beef_slice--raw"
          ]
        },
        {
          "order": 4,
          "instruction": "繼續煮約 2-3 分鐘至牛肉剛好熟透即可。過程中若有浮沫可以稍微撈除。",
          "method_id": "simmer_medium_heat",
          "duration_s": 180,
          "ingredient_ids": []
        },
        {
          "order": 5,
          "instruction": "準備好熱騰騰的白飯，將煮好的牛肉與洋蔥連同充滿精華的醬汁淋在飯上。依個人喜好放上一顆溫泉蛋即完成。",
          "method_id": "plate",
          "duration_s": 60,
          "ingredient_ids": [
            "white_rice--cooked",
            "egg_chicken--onsen"
          ]
        }
      ]
    }
  ],
  "tips": "一定要選用牛五花等富含油脂的火鍋肉片，口感才會軟嫩多汁。洋蔥也務必要先蓋鍋煮軟，甜味才能完整釋放到湯汁中。"
