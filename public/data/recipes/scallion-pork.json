      "id": "stovetop",
      "label": "爐灶版",
      "note": "大火快炒是蔥爆美味的關鍵，準備好所有材料再開火。",
      "steps": [
        {
          "order": 1,
          "instruction": "豬肉片先用一半的醬油及一小匙米酒抓醃靜置 10 分鐘。",
          "method_id": "marinate",
          "duration_s": 600,
          "ingredient_ids": [
            "pork_slice--raw",
            "soy_sauce--regular",
            "sake_cooking--rice"
          ]
        },
        {
          "order": 2,
          "instruction": "熱鍋熱油，下蒜片、辣椒與蔥白段，大火爆香約 15 秒。",
          "method_id": "stir_fry_high_heat",
          "duration_s": 15,
          "ingredient_ids": [
            "garlic_raw--sliced",
            "chili_fresh--red",
            "green_onion--sliced"
          ]
        },
        {
          "order": 3,
          "instruction": "下豬肉片快速翻炒至表面變色，淋入剩下的醬油與米酒，翻炒出醬香。",
          "method_id": "stir_fry_high_heat",
          "duration_s": 90,
          "ingredient_ids": [
            "pork_slice--raw",
            "soy_sauce--regular",
            "sake_cooking--rice"
          ]
        },
        {
          "order": 4,
          "instruction": "最後加入蔥綠段，翻炒均勻約 20 秒，起鍋前淋上香油提香即可盛盤。",
          "method_id": "stir_fry_high_heat",
          "duration_s": 20,
          "ingredient_ids": [
            "green_onion--sliced",
            "sesame_oil--white"
          ]
        }
      ]
    }
  ]
