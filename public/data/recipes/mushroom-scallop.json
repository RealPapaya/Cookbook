      "id": "stovetop",
      "label": "爐灶版",
      "note": "干貝不要煎太久，兩面金黃即可保持內裡軟嫩。",
      "steps": [
        {
          "order": 1,
          "instruction": "干貝兩面拍乾水分。起熱鍋下油，大火將干貝兩面各煎 1 分鐘至上色，取出備用。",
          "method_id": "pan_fry_high_heat",
          "duration_s": 120,
          "ingredient_ids": [
            "scallop--fresh"
          ]
        },
        {
          "order": 2,
          "instruction": "原鍋（不洗）加入蒜末與所有菇類，中火翻炒至菇類出水變軟並略微縮小。",
          "method_id": "stir_fry_medium_heat",
          "duration_s": 240,
          "ingredient_ids": [
            "shimeji--brown",
            "shiitake--fresh",
            "garlic_raw--minced"
          ]
        },
        {
          "order": 3,
          "instruction": "加入奶油與醬油調味，待奶油融化後將干貝放回鍋中，快速翻炒 30 秒混合氣味即完成。",
          "method_id": "stir_fry_medium_heat",
